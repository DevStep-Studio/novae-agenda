# ---------------------------------------------------------------------------
# RESERVEI — VARIÁVEIS DE AMBIENTE (PRODUÇÃO & DESENVOLVIMENTO)
# Copie para .env e preencha com as credenciais reais. NUNCA commite o .env.
# ---------------------------------------------------------------------------

# Ambiente de Execução
NODE_ENV="production"
PORT=3000

# URL Base Pública da Aplicação (usada em e-mails, links de agendamento e webhooks)
APP_URL="https://usereservei.com.br"

# Conexão Oficial com o Banco de Dados MySQL 8.0+
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://reservei_user:SUA_SENHA_SEGURA@127.0.0.1:3306/reservei_prod"

# Parâmetros Individuais do MySQL (caso seu provedor utilize separadamente)
DB_CONNECTION="mysql"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="reservei_prod"
DB_USERNAME="reservei_user"
DB_PASSWORD="SUA_SENHA_SEGURA"

# Segredo de Assinatura de Sessões JWT (Mínimo 32 caracteres)
# Gere no terminal com: openssl rand -base64 48
SESSION_SECRET="altere-para-uma-chave-secreta-forte-em-producao-com-mais-de-32-chars"

# Senha única de acesso ao Painel Super Admin (/admin) — login é feito só com esta senha.
# Gere no terminal com: openssl rand -base64 18 | tr -d '/+=' | cut -c1-20
ADMIN_PASSWORD="altere-para-uma-senha-forte-e-unica-do-super-admin"

# Gateway de Pagamentos Mercado Pago (Assinaturas SaaS do Proprietário)
# Obtenha no painel de desenvolvedor do Mercado Pago (Credenciais de Produção)
MERCADO_PAGO_PUBLIC_KEY="APP_USR-sua-public-key-de-producao"
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-seu-access-token-de-producao"
MERCADO_PAGO_WEBHOOK_SECRET="seu-webhook-secret"
MERCADO_PAGO_NOTIFICATION_URL="https://usereservei.com.br/api/webhooks/mercadopago"

# Envio de E-mails Transacionais ("resend" para produção ou "console" para testes locais)
EMAIL_TRANSPORT="resend"
RESEND_API_KEY="re_seu_token_resend"
EMAIL_FROM="Reservei <notificacoes@usereservei.com.br>"

# Segredo do Scheduler / Cron Worker (Lembretes automáticos 24h e 2h)
# Gere no terminal com: openssl rand -hex 32
CRON_SECRET="seu-cron-secret-para-disparos-automaticos"
