# ---------------------------------------------------------------------------
# Nova(e) — environment variables
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# MySQL connection string (required)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/novae_agenda"

# Secret used to sign session JWTs (required in production, min 16 chars).
# Generate one with: openssl rand -base64 48
SESSION_SECRET="change-me-in-production"

# Public base URL of the app, used to build links inside e-mails.
APP_URL="http://localhost:3000"

# Transactional e-mail transport: "console" (default, logs to server) or "resend".
EMAIL_TRANSPORT="console"

# Required only when EMAIL_TRANSPORT=resend
RESEND_API_KEY=""
EMAIL_FROM="Nova(e) <no-reply@your-domain.com>"

# Mercado Pago Integration (Recorrência e Assinaturas SaaS)
# Se vazio, o sistema operará em modo de simulação local para testes.
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# Secret required to trigger GET/POST /api/cron/booking-notifications (the
# 24h/2h appointment reminder worker). Generate with: openssl rand -hex 32
# Wire this URL to whatever scheduler you have — Vercel Cron, cron-job.org,
# GitHub Actions, or a VPS crontab hitting it with curl. See
# docs/agendamento-publico.md for exact setup per platform.
CRON_SECRET=""

