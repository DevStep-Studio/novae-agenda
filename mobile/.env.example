# Copy to .env.local (gitignored) to point the app at a non-production backend.
# Defaults to https://usereservei.com.br when unset — see src/lib/api-client.ts.
#
# Android emulator reaching your machine's local dev server: use 10.0.2.2 instead
# of localhost (the emulator's own loopback is not the host machine's).
# iOS Simulator can use localhost directly.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
