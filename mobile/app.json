{
  "expo": {
    "name": "Reservei",
    "slug": "reservei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reservei",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080808",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "br.com.usereservei.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSFaceIDUsageDescription": "Permita o uso do Face ID para desbloquear o Reservei com segurança.",
        "NSCalendarsUsageDescription": "O Reservei precisa de acesso ao calendário para salvar seus agendamentos.",
        "NSCalendarsFullAccessUsageDescription": "O Reservei precisa de acesso ao calendário para salvar seus agendamentos."
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "br.com.usereservei.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#080808",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080808",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#10B981",
          "sounds": []
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita o uso do Face ID para desbloquear o Reservei com segurança."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "O Reservei precisa de acesso ao seu calendário para sincronizar agendamentos."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "reservei-mobile"
      }
    }
  }
}
